{
  "$defs": {
    "ActionType": {
      "description": "The complete response catalog. The executor runs nothing outside this list.",
      "enum": [
        "block_ip",
        "disable_account",
        "isolate_host",
        "kill_process",
        "force_password_reset",
        "no_action"
      ],
      "title": "ActionType",
      "type": "string"
    },
    "AttackChainStep": {
      "additionalProperties": false,
      "properties": {
        "order": {
          "title": "Order",
          "type": "integer"
        },
        "tactic": {
          "title": "Tactic",
          "type": "string"
        },
        "technique_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Technique Id"
        },
        "technique_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Technique Name"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "order",
        "tactic",
        "description"
      ],
      "title": "AttackChainStep",
      "type": "object"
    },
    "Classification": {
      "enum": [
        "malicious",
        "benign",
        "inconclusive"
      ],
      "title": "Classification",
      "type": "string"
    },
    "EntityType": {
      "enum": [
        "host",
        "account",
        "ip_address",
        "process",
        "file"
      ],
      "title": "EntityType",
      "type": "string"
    },
    "EvaluationArm": {
      "enum": [
        "a1_rules_only",
        "a2a_raw_single_shot",
        "a2b_full_context",
        "a2c_oracle_bundle",
        "a3_tool_using_agent"
      ],
      "title": "EvaluationArm",
      "type": "string"
    },
    "InvestigationStopReason": {
      "enum": [
        "verdict_reached",
        "tool_call_cap",
        "invalid_output"
      ],
      "title": "InvestigationStopReason",
      "type": "string"
    },
    "ProposedAction": {
      "additionalProperties": false,
      "description": "An action the agent recommends. The agent NEVER executes this itself.",
      "properties": {
        "action_id": {
          "title": "Action Id",
          "type": "string"
        },
        "action_type": {
          "$ref": "#/$defs/ActionType"
        },
        "target_type": {
          "$ref": "#/$defs/EntityType"
        },
        "target_value": {
          "title": "Target Value",
          "type": "string"
        },
        "justification": {
          "title": "Justification",
          "type": "string"
        },
        "reversible": {
          "default": true,
          "title": "Reversible",
          "type": "boolean"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "action_type",
        "target_type",
        "target_value",
        "justification"
      ],
      "title": "ProposedAction",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The agent's structured conclusion about an incident.",
  "properties": {
    "verdict_id": {
      "title": "Verdict Id",
      "type": "string"
    },
    "incident_id": {
      "title": "Incident Id",
      "type": "string"
    },
    "arm": {
      "$ref": "#/$defs/EvaluationArm"
    },
    "classification": {
      "$ref": "#/$defs/Classification"
    },
    "confidence": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    },
    "attack_chain": {
      "items": {
        "$ref": "#/$defs/AttackChainStep"
      },
      "title": "Attack Chain",
      "type": "array"
    },
    "techniques": {
      "items": {
        "type": "string"
      },
      "title": "Techniques",
      "type": "array"
    },
    "cited_evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Cited Evidence Ids",
      "type": "array"
    },
    "risk_factors": {
      "items": {
        "type": "string"
      },
      "title": "Risk Factors",
      "type": "array"
    },
    "proposed_actions": {
      "items": {
        "$ref": "#/$defs/ProposedAction"
      },
      "title": "Proposed Actions",
      "type": "array"
    },
    "produced_at": {
      "format": "date-time",
      "title": "Produced At",
      "type": "string"
    },
    "model_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Name"
    },
    "tool_calls_made": {
      "default": 0,
      "title": "Tool Calls Made",
      "type": "integer"
    },
    "input_tokens": {
      "default": 0,
      "title": "Input Tokens",
      "type": "integer"
    },
    "output_tokens": {
      "default": 0,
      "title": "Output Tokens",
      "type": "integer"
    },
    "latency_ms": {
      "default": 0,
      "title": "Latency Ms",
      "type": "integer"
    },
    "stop_reason": {
      "$ref": "#/$defs/InvestigationStopReason"
    }
  },
  "required": [
    "incident_id",
    "arm",
    "classification",
    "confidence",
    "summary",
    "produced_at",
    "stop_reason"
  ],
  "title": "Verdict",
  "type": "object"
}
