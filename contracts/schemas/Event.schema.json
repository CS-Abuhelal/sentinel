{
  "$defs": {
    "EventCategory": {
      "enum": [
        "authentication",
        "process",
        "network",
        "file",
        "account_management",
        "privilege",
        "persistence",
        "other"
      ],
      "title": "EventCategory",
      "type": "string"
    },
    "NetworkInfo": {
      "additionalProperties": false,
      "properties": {
        "src_ip": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Src Ip"
        },
        "src_port": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Src Port"
        },
        "dst_ip": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dst Ip"
        },
        "dst_port": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dst Port"
        },
        "protocol": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Protocol"
        },
        "bytes_sent": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bytes Sent"
        },
        "bytes_received": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bytes Received"
        },
        "domain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain"
        }
      },
      "required": [
        "src_ip",
        "src_port",
        "dst_ip",
        "dst_port",
        "protocol",
        "bytes_sent",
        "bytes_received",
        "domain"
      ],
      "title": "NetworkInfo",
      "type": "object"
    },
    "ProcessInfo": {
      "additionalProperties": false,
      "properties": {
        "pid": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pid"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "command_line": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command Line"
        },
        "parent_pid": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Pid"
        },
        "parent_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Name"
        },
        "user": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User"
        },
        "hash_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hash Sha256"
        }
      },
      "required": [
        "pid",
        "name",
        "command_line",
        "parent_pid",
        "parent_name",
        "user",
        "hash_sha256"
      ],
      "title": "ProcessInfo",
      "type": "object"
    },
    "TelemetrySource": {
      "enum": [
        "windows_security",
        "windows_sysmon",
        "linux_auth",
        "linux_syslog",
        "linux_auditd",
        "zeek_conn",
        "zeek_dns",
        "zeek_http"
      ],
      "title": "TelemetrySource",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One normalized telemetry record. The atomic unit of evidence.",
  "properties": {
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "ingested_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ingested At"
    },
    "source": {
      "$ref": "#/$defs/TelemetrySource"
    },
    "category": {
      "$ref": "#/$defs/EventCategory"
    },
    "event_type": {
      "title": "Event Type",
      "type": "string"
    },
    "host": {
      "title": "Host",
      "type": "string"
    },
    "user": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "User"
    },
    "outcome": {
      "default": "unknown",
      "enum": [
        "success",
        "failure",
        "unknown"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "process": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProcessInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "network": {
      "anyOf": [
        {
          "$ref": "#/$defs/NetworkInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "file_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "File Path"
    },
    "message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Message"
    },
    "raw": {
      "additionalProperties": true,
      "title": "Raw",
      "type": "object"
    },
    "case_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Case Id"
    }
  },
  "required": [
    "event_id",
    "timestamp",
    "ingested_at",
    "source",
    "category",
    "event_type",
    "host",
    "user",
    "outcome",
    "process",
    "network",
    "file_path",
    "message",
    "raw",
    "case_id"
  ],
  "title": "Event",
  "type": "object"
}
