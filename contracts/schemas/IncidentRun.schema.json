{
  "$defs": {
    "ActionType": {
      "description": "The complete response catalog. The executor runs nothing outside this list.",
      "enum": [
        "block_ip",
        "disable_account",
        "isolate_host",
        "kill_process",
        "force_password_reset",
        "no_action"
      ],
      "title": "ActionType",
      "type": "string"
    },
    "Alert": {
      "additionalProperties": false,
      "description": "A detection rule fired. High recall by design; severity here is rule-declared,\nnot the final risk score.",
      "properties": {
        "alert_id": {
          "title": "Alert Id",
          "type": "string"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "rule_name": {
          "title": "Rule Name",
          "type": "string"
        },
        "rule_severity": {
          "$ref": "#/$defs/Severity"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "host": {
          "title": "Host",
          "type": "string"
        },
        "user": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User"
        },
        "src_ip": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Src Ip"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "event_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Event Ids",
          "type": "array"
        },
        "suggested_techniques": {
          "items": {
            "type": "string"
          },
          "title": "Suggested Techniques",
          "type": "array"
        },
        "case_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Case Id"
        }
      },
      "required": [
        "alert_id",
        "rule_id",
        "rule_name",
        "rule_severity",
        "timestamp",
        "host",
        "user",
        "src_ip",
        "description",
        "event_ids",
        "suggested_techniques",
        "case_id"
      ],
      "title": "Alert",
      "type": "object"
    },
    "Approval": {
      "additionalProperties": false,
      "description": "A human's answer to a decision that required approval. Nothing else can unlock one.",
      "properties": {
        "approval_id": {
          "title": "Approval Id",
          "type": "string"
        },
        "decision_id": {
          "title": "Decision Id",
          "type": "string"
        },
        "action_id": {
          "title": "Action Id",
          "type": "string"
        },
        "incident_id": {
          "title": "Incident Id",
          "type": "string"
        },
        "approved": {
          "title": "Approved",
          "type": "boolean"
        },
        "decided_by": {
          "minLength": 1,
          "title": "Decided By",
          "type": "string"
        },
        "decided_at": {
          "format": "date-time",
          "title": "Decided At",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "approval_id",
        "decision_id",
        "action_id",
        "incident_id",
        "approved",
        "decided_by",
        "decided_at",
        "source",
        "note"
      ],
      "title": "Approval",
      "type": "object"
    },
    "AttackChainStep": {
      "additionalProperties": false,
      "properties": {
        "order": {
          "title": "Order",
          "type": "integer"
        },
        "tactic": {
          "title": "Tactic",
          "type": "string"
        },
        "technique_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Technique Id"
        },
        "technique_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Technique Name"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "order",
        "tactic",
        "technique_id",
        "technique_name",
        "description",
        "evidence_ids"
      ],
      "title": "AttackChainStep",
      "type": "object"
    },
    "AuditKind": {
      "enum": [
        "proposal",
        "decision",
        "approval",
        "execution"
      ],
      "title": "AuditKind",
      "type": "string"
    },
    "AuditRecord": {
      "additionalProperties": false,
      "description": "One append-only audit entry. Each hash covers the previous one, so edits break the chain.",
      "properties": {
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AuditKind"
        },
        "incident_id": {
          "title": "Incident Id",
          "type": "string"
        },
        "subject_id": {
          "title": "Subject Id",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "prev_hash": {
          "title": "Prev Hash",
          "type": "string"
        },
        "hash": {
          "title": "Hash",
          "type": "string"
        }
      },
      "required": [
        "sequence",
        "recorded_at",
        "kind",
        "incident_id",
        "subject_id",
        "summary",
        "payload",
        "prev_hash",
        "hash"
      ],
      "title": "AuditRecord",
      "type": "object"
    },
    "AutonomyLevel": {
      "enum": [
        "observe_only",
        "suggest",
        "act_with_approval",
        "act_autonomously"
      ],
      "title": "AutonomyLevel",
      "type": "string"
    },
    "Classification": {
      "enum": [
        "malicious",
        "benign",
        "inconclusive"
      ],
      "title": "Classification",
      "type": "string"
    },
    "CommandResult": {
      "additionalProperties": false,
      "properties": {
        "argv": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Argv",
          "type": "array"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "output": {
          "default": "",
          "title": "Output",
          "type": "string"
        }
      },
      "required": [
        "argv",
        "exit_code",
        "output"
      ],
      "title": "CommandResult",
      "type": "object"
    },
    "Entity": {
      "additionalProperties": false,
      "properties": {
        "entity_type": {
          "$ref": "#/$defs/EntityType"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "is_protected": {
          "default": false,
          "title": "Is Protected",
          "type": "boolean"
        }
      },
      "required": [
        "entity_type",
        "value",
        "is_protected"
      ],
      "title": "Entity",
      "type": "object"
    },
    "EntityType": {
      "enum": [
        "host",
        "account",
        "ip_address",
        "process",
        "file"
      ],
      "title": "EntityType",
      "type": "string"
    },
    "EvaluationArm": {
      "enum": [
        "a1_rules_only",
        "a2a_raw_single_shot",
        "a2b_full_context",
        "a2c_oracle_bundle",
        "a3_tool_using_agent"
      ],
      "title": "EvaluationArm",
      "type": "string"
    },
    "Event": {
      "additionalProperties": false,
      "description": "One normalized telemetry record. The atomic unit of evidence.",
      "properties": {
        "event_id": {
          "title": "Event Id",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "ingested_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ingested At"
        },
        "source": {
          "$ref": "#/$defs/TelemetrySource"
        },
        "category": {
          "$ref": "#/$defs/EventCategory"
        },
        "event_type": {
          "title": "Event Type",
          "type": "string"
        },
        "host": {
          "title": "Host",
          "type": "string"
        },
        "user": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "User"
        },
        "outcome": {
          "default": "unknown",
          "enum": [
            "success",
            "failure",
            "unknown"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "process": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProcessInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "network": {
          "anyOf": [
            {
              "$ref": "#/$defs/NetworkInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "file_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File Path"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "raw": {
          "additionalProperties": true,
          "title": "Raw",
          "type": "object"
        },
        "case_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Case Id"
        }
      },
      "required": [
        "event_id",
        "timestamp",
        "ingested_at",
        "source",
        "category",
        "event_type",
        "host",
        "user",
        "outcome",
        "process",
        "network",
        "file_path",
        "message",
        "raw",
        "case_id"
      ],
      "title": "Event",
      "type": "object"
    },
    "EventCategory": {
      "enum": [
        "authentication",
        "process",
        "network",
        "file",
        "account_management",
        "privilege",
        "persistence",
        "other"
      ],
      "title": "EventCategory",
      "type": "string"
    },
    "EvidenceClass": {
      "description": "Ground-truth evidence categories. Drives Evidence Coverage and Utilization metrics.",
      "enum": [
        "auth_history",
        "entity_context",
        "process_lineage",
        "network_activity",
        "file_activity",
        "change_window",
        "related_alerts",
        "threat_intel",
        "baseline_comparison"
      ],
      "title": "EvidenceClass",
      "type": "string"
    },
    "EvidenceItem": {
      "additionalProperties": false,
      "description": "One piece of evidence a tool retrieved. Carries provenance so an analyst can verify it.",
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "incident_id": {
          "title": "Incident Id",
          "type": "string"
        },
        "evidence_class": {
          "$ref": "#/$defs/EvidenceClass"
        },
        "tool_name": {
          "title": "Tool Name",
          "type": "string"
        },
        "tool_query": {
          "additionalProperties": true,
          "title": "Tool Query",
          "type": "object"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "content": {
          "additionalProperties": true,
          "title": "Content",
          "type": "object"
        },
        "source_event_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Event Ids",
          "type": "array"
        },
        "was_productive": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Was Productive"
        }
      },
      "required": [
        "evidence_id",
        "incident_id",
        "evidence_class",
        "tool_name",
        "tool_query",
        "retrieved_at",
        "summary",
        "content",
        "source_event_ids",
        "was_productive"
      ],
      "title": "EvidenceItem",
      "type": "object"
    },
    "ExecutionResult": {
      "additionalProperties": false,
      "description": "What the executor did with one decision on one host. Rejected means nothing ran.",
      "properties": {
        "execution_id": {
          "title": "Execution Id",
          "type": "string"
        },
        "decision_id": {
          "title": "Decision Id",
          "type": "string"
        },
        "action_id": {
          "title": "Action Id",
          "type": "string"
        },
        "incident_id": {
          "title": "Incident Id",
          "type": "string"
        },
        "action_type": {
          "$ref": "#/$defs/ActionType"
        },
        "target_type": {
          "$ref": "#/$defs/EntityType"
        },
        "target_value": {
          "title": "Target Value",
          "type": "string"
        },
        "host": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Host"
        },
        "status": {
          "$ref": "#/$defs/ExecutionStatus"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "dry_run": {
          "default": false,
          "title": "Dry Run",
          "type": "boolean"
        },
        "before": {
          "items": {
            "$ref": "#/$defs/CommandResult"
          },
          "title": "Before",
          "type": "array"
        },
        "commands": {
          "items": {
            "$ref": "#/$defs/CommandResult"
          },
          "title": "Commands",
          "type": "array"
        },
        "verified": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verified"
        },
        "verification": {
          "items": {
            "$ref": "#/$defs/CommandResult"
          },
          "title": "Verification",
          "type": "array"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "finished_at": {
          "format": "date-time",
          "title": "Finished At",
          "type": "string"
        }
      },
      "required": [
        "execution_id",
        "decision_id",
        "action_id",
        "incident_id",
        "action_type",
        "target_type",
        "target_value",
        "host",
        "status",
        "reason",
        "dry_run",
        "before",
        "commands",
        "verified",
        "verification",
        "started_at",
        "finished_at"
      ],
      "title": "ExecutionResult",
      "type": "object"
    },
    "ExecutionStatus": {
      "enum": [
        "succeeded",
        "failed",
        "rejected"
      ],
      "title": "ExecutionStatus",
      "type": "string"
    },
    "Incident": {
      "additionalProperties": false,
      "description": "Correlated group of alerts. The unit the agent investigates.",
      "properties": {
        "incident_id": {
          "title": "Incident Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/IncidentStatus",
          "default": "new"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated At"
        },
        "window_start": {
          "format": "date-time",
          "title": "Window Start",
          "type": "string"
        },
        "window_end": {
          "format": "date-time",
          "title": "Window End",
          "type": "string"
        },
        "alert_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Alert Ids",
          "type": "array"
        },
        "entities": {
          "items": {
            "$ref": "#/$defs/Entity"
          },
          "title": "Entities",
          "type": "array"
        },
        "case_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Case Id"
        }
      },
      "required": [
        "incident_id",
        "title",
        "status",
        "created_at",
        "updated_at",
        "window_start",
        "window_end",
        "alert_ids",
        "entities",
        "case_id"
      ],
      "title": "Incident",
      "type": "object"
    },
    "IncidentStatus": {
      "enum": [
        "new",
        "investigating",
        "awaiting_approval",
        "resolved",
        "closed_benign"
      ],
      "title": "IncidentStatus",
      "type": "string"
    },
    "InvestigationStopReason": {
      "enum": [
        "verdict_reached",
        "tool_call_cap",
        "invalid_output"
      ],
      "title": "InvestigationStopReason",
      "type": "string"
    },
    "NetworkInfo": {
      "additionalProperties": false,
      "properties": {
        "src_ip": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Src Ip"
        },
        "src_port": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Src Port"
        },
        "dst_ip": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dst Ip"
        },
        "dst_port": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dst Port"
        },
        "protocol": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Protocol"
        },
        "bytes_sent": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bytes Sent"
        },
        "bytes_received": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bytes Received"
        },
        "domain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain"
        }
      },
      "required": [
        "src_ip",
        "src_port",
        "dst_ip",
        "dst_port",
        "protocol",
        "bytes_sent",
        "bytes_received",
        "domain"
      ],
      "title": "NetworkInfo",
      "type": "object"
    },
    "PolicyDecision": {
      "additionalProperties": false,
      "description": "Deterministic authorization result. This, not the agent, decides what may run.",
      "properties": {
        "decision_id": {
          "title": "Decision Id",
          "type": "string"
        },
        "action_id": {
          "title": "Action Id",
          "type": "string"
        },
        "incident_id": {
          "title": "Incident Id",
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/PolicyOutcome"
        },
        "autonomy_level": {
          "$ref": "#/$defs/AutonomyLevel"
        },
        "risk_score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Risk Score",
          "type": "integer"
        },
        "matched_rule": {
          "title": "Matched Rule",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "target_is_protected": {
          "default": false,
          "title": "Target Is Protected",
          "type": "boolean"
        },
        "decided_at": {
          "format": "date-time",
          "title": "Decided At",
          "type": "string"
        },
        "approved_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approved By"
        },
        "approved_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approved At"
        }
      },
      "required": [
        "decision_id",
        "action_id",
        "incident_id",
        "outcome",
        "autonomy_level",
        "risk_score",
        "matched_rule",
        "reason",
        "target_is_protected",
        "decided_at",
        "approved_by",
        "approved_at"
      ],
      "title": "PolicyDecision",
      "type": "object"
    },
    "PolicyOutcome": {
      "enum": [
        "allow",
        "require_approval",
        "deny"
      ],
      "title": "PolicyOutcome",
