{
  "$defs": {
    "Severity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A detection rule fired. High recall by design; severity here is rule-declared,\nnot the final risk score.",
  "properties": {
    "alert_id": {
      "title": "Alert Id",
      "type": "string"
    },
    "rule_id": {
      "title": "Rule Id",
      "type": "string"
    },
    "rule_name": {
      "title": "Rule Name",
      "type": "string"
    },
    "rule_severity": {
      "$ref": "#/$defs/Severity"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "host": {
      "title": "Host",
      "type": "string"
    },
    "user": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "User"
    },
    "src_ip": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Src Ip"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "event_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Event Ids",
      "type": "array"
    },
    "suggested_techniques": {
      "items": {
        "type": "string"
      },
      "title": "Suggested Techniques",
      "type": "array"
    },
    "case_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Case Id"
    }
  },
  "required": [
    "rule_id",
    "rule_name",
    "rule_severity",
    "timestamp",
    "host",
    "description"
  ],
  "title": "Alert",
  "type": "object"
}
