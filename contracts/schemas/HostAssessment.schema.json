{
  "$defs": {
    "Finding": {
      "additionalProperties": false,
      "description": "One weak spot on a monitored PC: a vulnerable package or a failed CIS check.",
      "properties": {
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/FindingKind"
        },
        "key": {
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "host": {
          "title": "Host",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "priority": {
          "maximum": 100,
          "minimum": 0,
          "title": "Priority",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/FindingStatus",
          "default": "open"
        },
        "cve": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cve"
        },
        "package": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Package"
        },
        "installed_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Installed Version"
        },
        "cvss": {
          "anyOf": [
            {
              "maximum": 10.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cvss"
        },
        "policy_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Id"
        },
        "check_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Check Id"
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "official_remediation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Official Remediation"
        },
        "references": {
          "items": {
            "type": "string"
          },
          "title": "References",
          "type": "array"
        },
        "related_alert_count": {
          "default": 0,
          "minimum": 0,
          "title": "Related Alert Count",
          "type": "integer"
        },
        "first_seen": {
          "format": "date-time",
          "title": "First Seen",
          "type": "string"
        },
        "last_seen": {
          "format": "date-time",
          "title": "Last Seen",
          "type": "string"
        },
        "raw": {
          "additionalProperties": true,
          "title": "Raw",
          "type": "object"
        }
      },
      "required": [
        "finding_id",
        "kind",
        "key",
        "host",
        "title",
        "severity",
        "priority",
        "status",
        "cve",
        "package",
        "installed_version",
        "cvss",
        "policy_id",
        "check_id",
        "rationale",
        "official_remediation",
        "references",
        "related_alert_count",
        "first_seen",
        "last_seen",
        "raw"
      ],
      "title": "Finding",
      "type": "object"
    },
    "FindingKind": {
      "enum": [
        "vulnerability",
        "configuration"
      ],
      "title": "FindingKind",
      "type": "string"
    },
    "FindingStatus": {
      "enum": [
        "open",
        "resolved"
      ],
      "title": "FindingStatus",
      "type": "string"
    },
    "Recommendation": {
      "additionalProperties": false,
      "description": "Plain-language advice for the owner of a monitored PC. SENTINEL never carries it out.",
      "properties": {
        "recommendation_id": {
          "title": "Recommendation Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "priority": {
          "maximum": 100,
          "minimum": 0,
          "title": "Priority",
          "type": "integer"
        },
        "steps": {
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "title": "Steps",
          "type": "array"
        },
        "finding_ids": {
          "items": {
            "type": "string"
          },
          "title": "Finding Ids",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "official_remediation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Official Remediation"
        },
        "dropped_steps": {
          "items": {
            "type": "string"
          },
          "title": "Dropped Steps",
          "type": "array"
        }
      },
      "required": [
        "recommendation_id",
        "title",
        "priority",
        "steps",
        "finding_ids",
        "evidence_ids",
        "official_remediation",
        "dropped_steps"
      ],
      "title": "Recommendation",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "The weak spots found on one PC and the advice written for them.",
  "properties": {
    "assessment_id": {
      "title": "Assessment Id",
      "type": "string"
    },
    "host": {
      "title": "Host",
      "type": "string"
    },
    "contract_version": {
      "default": "1.8.0",
      "title": "Contract Version",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "synced_at": {
      "format": "date-time",
      "title": "Synced At",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "recommendations": {
      "items": {
        "$ref": "#/$defs/Recommendation"
      },
      "title": "Recommendations",
      "type": "array"
    },
    "model_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Name"
    }
  },
  "required": [
    "assessment_id",
    "host",
    "contract_version",
    "created_at",
    "synced_at",
    "findings",
    "recommendations",
    "model_name"
  ],
  "title": "HostAssessment",
  "type": "object"
}
